extends Node
## Sound effect pool + music. All sounds are generated by scripts/generate_audio.py.

const SOUNDS := {
	"shoot": preload("res://assets/sfx/shoot.wav"),
	"enemy_shoot": preload("res://assets/sfx/enemy_shoot.wav"),
	"hit": preload("res://assets/sfx/hit.wav"),
	"explode": preload("res://assets/sfx/explode.wav"),
	"player_hit": preload("res://assets/sfx/player_hit.wav"),
	"pickup": preload("res://assets/sfx/pickup.wav"),
	"powerup": preload("res://assets/sfx/powerup.wav"),
	"death": preload("res://assets/sfx/death.wav"),
	"wave": preload("res://assets/sfx/wave.wav"),
	"ui": preload("res://assets/sfx/ui.wav"),
	"dash": preload("res://assets/sfx/dash.wav"),
	"spawn": preload("res://assets/sfx/spawn.wav"),
}
const MUSIC := preload("res://assets/music/neon_loop.ogg")
const VOICES := 16

signal mute_changed(muted: bool)

var _players: Array[AudioStreamPlayer] = []
var _next := 0
var _music: AudioStreamPlayer


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i in VOICES:
		var p := AudioStreamPlayer.new()
		add_child(p)
		_players.append(p)
	var music := MUSIC.duplicate() as AudioStreamOggVorbis
	music.loop = true
	_music = AudioStreamPlayer.new()
	_music.stream = music
	_music.volume_db = -11.0
	add_child(_music)
	AudioServer.set_bus_mute(0, GameState.muted)


func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed("mute"):
		toggle_mute()


## Plays a one-shot effect with slight random pitch so repeats don't sound robotic.
func play(sound: StringName, volume_db: float = 0.0, pitch_jitter: float = 0.06) -> void:
	if not SOUNDS.has(sound):
		push_warning("Unknown sound: %s" % sound)
		return
	var p := _players[_next]
	_next = (_next + 1) % VOICES
	p.stream = SOUNDS[sound]
	p.volume_db = volume_db
	p.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
	p.play()


func start_music() -> void:
	if not _music.playing:
		_music.play()


func toggle_mute() -> void:
	GameState.muted = not GameState.muted
	AudioServer.set_bus_mute(0, GameState.muted)
	GameState.save()
	mute_changed.emit(GameState.muted)
